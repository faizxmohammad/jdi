# Generate with: openssl rand -hex 32
# Never commit .env
JUST_DO_IT_TOKEN=replace-with-at-least-32-random-characters

# Owner id permanently bound to JUST_DO_IT_TOKEN (required).
JUST_DO_IT_OWNER_ID=solo-operator

# local | private | public (public refuses to start — see docs/deployment-modes.md)
JUST_DO_IT_DEPLOYMENT_MODE=local

# Optional extra API tokens file (per-token ownerId + optional orgId/scopes + revocation).
# See docs/deployment-modes.md and docs/team-model.md
# JUST_DO_IT_API_TOKENS_PATH=./secrets/api-tokens.json

# Optional team orgs file (required if any credential sets orgId). See docs/team-model.md
# JUST_DO_IT_ORGS_PATH=./secrets/orgs.json

# Phase 3 project memory (SQLite). Use :memory: only for ephemeral tests.
# JUST_DO_IT_MEMORY_PATH=./data/memory.sqlite
# JUST_DO_IT_MEMORY_DEFAULT_RETENTION_DAYS=0

# Gateway limits (self-host)
# JUST_DO_IT_RATE_LIMIT_WINDOW_MS=60000
# JUST_DO_IT_RATE_LIMIT_MAX=120
# JUST_DO_IT_JSON_BODY_LIMIT=1mb

# Set true only when debugging auth (noisy under MCP)
# JUST_DO_IT_AUDIT_AUTH_OK=false

# Context7 proxy. Default off. The agent still receives the MCP URL and tool schema.
# JUST_DO_IT_EXTERNAL_CALLS=enabled
# CONTEXT7_API_KEY=
# JUST_DO_IT_CONTEXT7_API_BASE=https://context7.com/api

# Optional live skill-evaluation model. Omit all three to keep `npm run eval:skills` simulated.
# The harness never reads these unless you pass --live. Do not commit real keys.
# JUST_DO_IT_EVAL_API_KEY=
# JUST_DO_IT_EVAL_BASE_URL=https://api.openai.com/v1
# JUST_DO_IT_EVAL_MODEL=
