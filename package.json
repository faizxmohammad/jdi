{
  "name": "just-do-it",
  "version": "0.1.0",
  "private": false,
  "description": "Just Do It — self-hosted, Git-backed skills catalog and MCP server for AI coding clients",
  "type": "module",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import-skill": "tsx src/cli/import-skill.ts",
    "just-do-it": "tsx src/cli/just-do-it.ts",
    "eval:recommend": "JUST_DO_IT_TOKEN=eval-token-xxxxxxxxxxxxxxxxxxxxxxx JUST_DO_IT_OWNER_ID=eval-owner NODE_ENV=test tsx src/cli/eval-recommend.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
